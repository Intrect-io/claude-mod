  "tagLine": [
    {
      "name": "the session's tag is replaced by the sub-issue's",
      "queue": "- [x] done thing :: check: true\n- [ ] [AGT-5] first step :: check: true\n- [ ] second step :: check: true\n- [ ] [AGT-7] someone else's issue :: check: true\n- [!] blocked step :: check: true\n",
      "line": 1,
      "id": "AGT-9",
      "expect": "- [x] done thing :: check: true\n- [ ] [AGT-9] first step :: check: true\n- [ ] second step :: check: true\n- [ ] [AGT-7] someone else's issue :: check: true\n- [!] blocked step :: check: true\n"
    },
    {
      "name": "an untagged line gets the sub-issue's tag",
      "queue": "- [x] done thing :: check: true\n- [ ] [AGT-5] first step :: check: true\n- [ ] second step :: check: true\n- [ ] [AGT-7] someone else's issue :: check: true\n- [!] blocked step :: check: true\n",
      "line": 2,
      "id": "AGT-10",
      "expect": "- [x] done thing :: check: true\n- [ ] [AGT-5] first step :: check: true\n- [ ] [AGT-10] second step :: check: true\n- [ ] [AGT-7] someone else's issue :: check: true\n- [!] blocked step :: check: true\n"
    },
    {
      "name": "several leading tags become the one tag",
      "queue": "- [ ] [AGT-5][AGT-7] step :: check: true\n",
      "line": 0,
      "id": "AGT-9",
      "expect": "- [ ] [AGT-9] step :: check: true\n"
    },
    {
      "name": "only the given line changes when an identical line comes first",
      "queue": "- [ ] step :: check: true\n- [ ] step :: check: true\n",
      "line": 1,
      "id": "AGT-9",
      "expect": "- [ ] step :: check: true\n- [ ] [AGT-9] step :: check: true\n"
    },
    {
      "name": "leading tags separated by spaces are all replaced",
      "queue": "- [ ] [AGT-5] [AGT-7] step :: check: true\n",
      "line": 0,
      "id": "AGT-9",
      "expect": "- [ ] [AGT-9] step :: check: true\n"
    },
    {
      "name": "CRLF line ends and trailing spaces on other lines are kept",
      "queue": "note  \r\n- [ ] a :: check: true\r\n- [ ] b :: check: true \r\n",
      "line": 1,
      "id": "AGT-9",
      "expect": "note  \r\n- [ ] [AGT-9] a :: check: true\r\n- [ ] b :: check: true \r\n"
    },
    {
      "name": "leading tags separated by several spaces or a tab are all replaced",
      "queue": "- [ ] [AGT-5]  [AGT-7]\t[AGT-8] step :: check: true\n",
      "line": 0,
      "id": "AGT-9",
      "expect": "- [ ] [AGT-9] step :: check: true\n"
    },
    {
      "name": "an issue named later in the text is kept",
      "queue": "- [ ] port fix from [AGT-7] :: check: true\n",
      "line": 0,
      "id": "AGT-9",
      "expect": "- [ ] [AGT-9] port fix from [AGT-7] :: check: true\n"
    },
    {
      "name": "a tab-indented item keeps its tab",
      "queue": "\t- [ ] step :: check: true\n",
      "line": 0,
      "id": "AGT-9",
      "expect": "\t- [ ] [AGT-9] step :: check: true\n"
    },
    {
      "name": "an indented star bullet keeps its own prefix",
      "queue": "  * [ ] second step :: check: true\n",
      "line": 0,
      "id": "AGT-10",
      "expect": "  * [ ] [AGT-10] second step :: check: true\n"
    }
  ]
}
