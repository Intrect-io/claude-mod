  "decomposeTargets": [
    {
      "name": "open lines tagged with nothing or only with the session's issue are targets; another issue's line, done and blocked lines are not",
      "queue": "- [x] done thing :: check: true\n- [ ] [AGT-5] first step :: check: true\n- [ ] second step :: check: true\n- [ ] [AGT-7] someone else's issue :: check: true\n- [!] blocked step :: check: true\n",
      "session": "AGT-5",
      "expect": [
        {
          "line": 1,
          "title": "first step"
        },
        {
          "line": 2,
          "title": "second step"
        }
      ]
    },
    {
      "name": "line is the raw line number, counting headings and blank lines",
      "queue": "# Goals\n\n- [ ] [AGT-5] first step :: check: true\n- [ ] second step :: check: true\n",
      "session": "AGT-5",
      "expect": [
        {
          "line": 2,
          "title": "first step"
        },
        {
          "line": 3,
          "title": "second step"
        }
      ]
    },
    {
      "name": "a line tagged with the session and another issue is not a target",
      "queue": "- [ ] [AGT-5][AGT-7] shared step :: check: true\n- [ ] a :: check: true\n- [ ] b :: check: true\n",
      "session": "AGT-5",
      "expect": [
        {
          "line": 1,
          "title": "a"
        },
        {
          "line": 2,
          "title": "b"
        }
      ]
    },
    {
      "name": "lines tagged with other issues are not targets even when the session's tag appears nowhere",
      "queue": "- [ ] [AGT-7] other :: check: true\n- [ ] [AGT-8] other2 :: check: true\n- [ ] mine :: check: true\n",
      "session": "AGT-5",
      "expect": []
    },
    {
      "name": "a single target is not decomposed",
      "queue": "- [x] done thing :: check: true\n- [ ] [AGT-5] only step :: check: true\n",
      "session": "AGT-5",
      "expect": []
    },
    {
      "name": "an issue whose key starts with the session's is still another issue",
      "queue": "- [ ] [AGT-50] theirs :: check: true\n- [ ] a :: check: true\n- [ ] b :: check: true\n",
      "session": "AGT-5",
      "expect": [
        {
          "line": 1,
          "title": "a"
        },
        {
          "line": 2,
          "title": "b"
        }
      ]
    },
    {
      "name": "a session whose key starts with a line's tag is still another issue",
      "queue": "- [ ] [AGT-5] theirs :: check: true\n- [ ] a :: check: true\n- [ ] b :: check: true\n",
      "session": "AGT-50",
      "expect": [
        {
          "line": 1,
          "title": "a"
        },
        {
          "line": 2,
          "title": "b"
        }
      ]
    },
    {
      "name": "open lines without a check are targets too",
      "queue": "- [ ] [AGT-5] title: what Linear AGT-5 asks is resolved on this branch\n- [ ] a\n",
      "session": "AGT-5",
      "expect": [
        {
          "line": 0,
          "title": "title: what Linear AGT-5 asks is resolved on this branch"
        },
        {
          "line": 1,
          "title": "a"
        }
      ]
    },
    {
      "name": "an issue named later in the text is not a leading tag",
      "queue": "- [ ] port the fix from [AGT-7] :: check: true\n- [ ] a :: check: true\n",
      "session": "AGT-5",
      "expect": [
        {
          "line": 0,
          "title": "port the fix from [AGT-7]"
        },
        {
          "line": 1,
          "title": "a"
        }
      ]
    },
    {
      "name": "leading tags separated by spaces count as leading tags",
      "queue": "- [ ] [AGT-5] [AGT-7] shared :: check: true\n- [ ] a :: check: true\n- [ ] b :: check: true\n",
      "session": "AGT-5",
      "expect": [
        {
          "line": 1,
          "title": "a"
        },
        {
          "line": 2,
          "title": "b"
        }
      ]
    },
    {
      "name": "the title is cut after the tags are removed",
      "queue": "- [ ] [AGT-5] pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp :: check: true\n- [ ] second :: check: true\n",
      "session": "AGT-5",
      "expect": [
        {
          "line": 0,
          "title": "pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp"
        },
        {
          "line": 1,
          "title": "second"
        }
      ]
    },
    {
      "name": "titles are cut to 80 characters",
      "queue": "- [ ] pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp :: check: true\n- [ ] qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq :: check: true\n",
      "session": "AGT-5",
      "expect": [
        {
          "line": 0,
          "title": "pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp"
        },
        {
          "line": 1,
          "title": "qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq"
        }
      ]
    }
